component vehicle
    nodes
        W = foundation.mechanical.rotational.rotational;
    end
    inputs
        grade = {0, '1'};
        F_brake = {0, 'N'};
    end
    outputs
        v = {0, 'm/s'};
    end
    parameters
        r_w = {0.508, 'm'};
        m_tot = {1.62e6, 'kg'};
        m_eff = {1.70e6, 'kg'};
        Crr = {0.002, '1'};
        CdA = {8, 'm^2'};
        rho = {1.225, 'kg/m^3'};
        g = {9.81, 'm/s^2'};
        v_eps = {0.1, 'm/s'};
    end
    variables
        t = {0, 'N*m'};
        w = {0, 'rad/s'};
    end
    branches
        t : W.t -> *;
    end
    equations
        w == W.w;
        let
            vv = w*r_w;
            s = tanh(vv/v_eps);
            F = m_tot*g*(Crr*s + grade/100) + 0.5*rho*CdA*vv*abs(vv) + F_brake*s;
        in
            t == m_eff*r_w^2*der(w) + F*r_w;
            v == vv;
        end
    end
end
